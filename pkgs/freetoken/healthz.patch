+    # Readiness probe for process supervisors. /health above answers 200 for
+    # every lifecycle state, so a supervisor that reads only the status code
+    # treats a loading engine, and a dead one, as ready. This route answers 503
+    # until the engine serves. The body is the same document.
+    @app.get("/healthz")
+    async def healthz():
+        doc = build_health(get_state(), app.version)
+        return JSONResponse(doc, status_code=200 if doc.get("status") == "ok" else 503)
